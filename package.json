{
  "name": "forge",
  "version": "0.1.0",
  "private": true,
  "description": "Code Fluency Training Platform — a language-agnostic deliberate-practice environment for building independent coding fluency.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "languages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "build:watch": "tsc --build --watch",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build --dry --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "forge": "node --experimental-strip-types packages/cli/src/main.ts",
    "verify": "npm run generate:check && npm run lint && npm run build && npm run test",
    "generate": "node scripts/generate-python-sources.mjs",
    "generate:check": "node scripts/generate-python-sources.mjs --check",
    "bundle": "node packages/cli/dist/main.js content bundle",
    "web": "npm run build && npm run bundle && npm run build --workspace @forge/web",
    "web:dev": "npm run bundle && npm run dev --workspace @forge/web",
    "e2e": "npm run web && npm run e2e --workspace @forge/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "globby": "^16.2.4",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
