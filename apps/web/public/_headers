# Cloudflare Pages headers. GitHub Pages ignores this file, which is harmless.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  # Learner code runs in a WASM sandbox inside a worker. wasm-unsafe-eval is
  # what WebAssembly requires; it does not permit eval of JavaScript.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; worker-src 'self' blob:; connect-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; base-uri 'none'; form-action 'none'

# Hashed assets are immutable.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The curriculum changes with every content update.
/content/*
  Cache-Control: public, max-age=300, must-revalidate
