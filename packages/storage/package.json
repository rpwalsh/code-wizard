{
  "name": "@forge/storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "default": "./dist/sqlite.js"
    },
    "./indexeddb": {
      "types": "./dist/indexeddb.d.ts",
      "default": "./dist/indexeddb.js"
    }
  },
  "dependencies": {
    "@forge/core": "*",
    "@forge/learning": "*"
  },
  "scripts": {
    "build": "tsc --build"
  }
}
